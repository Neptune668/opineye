# 运行环境
ENV=dev

# MySQL
DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/opineye

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 仓储后端切换：mysql | memory（单元测试用 memory）
REPO_BACKEND=mysql

# 日志
LOG_LEVEL=DEBUG

# LLM（可选，留空走规则引擎离线模式）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Tavily 搜索（可选，留空则 news 来源回退 file 数据源）
TAVILY_API_KEY=

# 知乎（可选，z_c0 登录凭证，用于访问热榜接口；留空则 forum_post 来源回退 file 数据源）
z_c0=

# 安全（预留）
SECRET_KEY=change-me

#tavily