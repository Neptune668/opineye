{
  "version": 1,
  "system": {
    "name": "opineye",
    "default_apps": ["topic_search", "media_search", "forum_collect", "insight", "report", "graph"]
  },
  "apps": {
    "topic_search": { "enabled": true },
    "media_search": { "enabled": true },
    "forum_collect": { "enabled": true },
    "insight": { "enabled": true },
    "report": { "enabled": true },
    "graph": { "enabled": true }
  },
  "search": {
    "max_sources": 100,
    "timeout_seconds": 30
  },
  "datasources": {
    "news":       { "type": "tavily", "topic": "news", "max_results": 10 },
    "image":      { "type": "file", "path": "data/image.json" },
    "video":      { "type": "file", "path": "data/video.json" },
    "forum_post": { "type": "file", "path": "data/forum_post.json" }
  },
  "forum": {
    "poll_interval_seconds": 10
  },
  "analysis": {
    "mode": "rule"
  }
}
